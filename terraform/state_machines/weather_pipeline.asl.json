{
  "Comment": "Ingest one day of weather readings into raw, load each source into bronze, then clean the batch into silver. Input: {\"date\": \"YYYY-MM-DD\"} (optional).",
  "StartAt": "Ingest",
  "States": {
    "Ingest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ingest_function}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "date.$": "$.Payload.date",
        "sources.$": "$.Payload.sources",
        "files.$": "$.Payload.files"
      },
      "Retry": [
        {
          "Comment": "Only transient errors: rewriting the same raw keys is idempotent. A bad input (ValueError) fails at once instead of being retried",
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException", "HTTPError", "URLError", "TimeoutError", "States.Timeout"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed" }],
      "Next": "LoadEachSource"
    },
    "LoadEachSource": {
      "Type": "Map",
      "ItemsPath": "$.sources",
      "ItemSelector": {
        "source.$": "$$.Map.Item.Value",
        "date.$": "$.date",
        "batch_id.$": "$$.Execution.Name"
      },
      "MaxConcurrency": 2,
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "LoadRawFiles",
        "States": {
          "LoadRawFiles": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun.sync",
            "Parameters": {
              "JobName": "${load_job}",
              "Arguments": {
                "--source.$": "$.source",
                "--date.$": "$.date",
                "--batch_id.$": "$.batch_id"
              }
            },
            "ResultSelector": {
              "job_run_id.$": "$.Id",
              "state.$": "$.JobRunState",
              "execution_seconds.$": "$.ExecutionTime"
            },
            "Retry": [
              {
                "Comment": "Only errors from before the job ran. A failed job isn't retried: bronze appends, so a retry after a commit would load the batch twice",
                "ErrorEquals": ["Glue.ConcurrentRunsExceededException", "Glue.ThrottlingException", "Glue.InternalServiceException"],
                "IntervalSeconds": 30,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
        }
      },
      "ResultPath": "$.loads",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed" }],
      "Next": "CleanReadings"
    },
    "CleanReadings": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${clean_job}",
        "Arguments": {
          "--batch_id.$": "$$.Execution.Name"
        }
      },
      "ResultSelector": {
        "job_run_id.$": "$.Id",
        "state.$": "$.JobRunState",
        "execution_seconds.$": "$.ExecutionTime"
      },
      "ResultPath": "$.clean",
      "Retry": [
        {
          "Comment": "Same pre-run errors as the load. A failed run would be safe to retry here (the MERGE is idempotent), but a failure is usually a bug or a failed check, which a retry only repeats",
          "ErrorEquals": ["Glue.ConcurrentRunsExceededException", "Glue.ThrottlingException", "Glue.InternalServiceException"],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed" }],
      "End": true
    },
    "Failed": {
      "Type": "Fail",
      "Error": "WeatherPipelineFailed",
      "Comment": "Step 4 adds an SNS alert here"
    }
  }
}
